# ─── Copiá este archivo a .env.local y completá los valores ───

# Modo local con emuladores (no necesita un proyecto real de Firebase).
# Poné "false" para usar un proyecto real.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Configuración web de Firebase (Consola de Firebase > Configuración del proyecto > Tus apps)
# Con emuladores alcanza con el projectId "demo-cafelink" y valores de relleno.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cafelink.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cafelink
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Admin SDK (solo servidor). Con emuladores NO hace falta completar las credenciales.
FIREBASE_ADMIN_PROJECT_ID=demo-cafelink
FIREBASE_ADMIN_CLIENT_EMAIL=
# Pegá la clave privada con los saltos de línea como \n y entre comillas dobles
FIREBASE_ADMIN_PRIVATE_KEY=

# Hosts de emuladores (el Admin SDK los detecta solo cuando estas variables existen)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Secreto para firmar los QR rotativos del mostrador (mínimo 32 caracteres).
# Generá uno con: openssl rand -base64 48
QR_SIGNING_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-32-o-mas
