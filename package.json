{
  "name": "cafelink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "pnpx --yes firebase-tools@latest emulators:start --only auth,firestore --project demo-cafelink --import=.emulator-data --export-on-exit",
    "deploy:rules": "pnpx --yes firebase-tools@latest deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
